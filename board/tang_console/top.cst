IO_PORT "sdram_dq[15]" IO_TYPE=LVCMOS33;
IO_LOC  "sdram_addr[0]" D19;
IO_PORT "sdram_addr[0]" IO_TYPE=LVCMOS33;
IO_LOC  "sdram_addr[1]" E19;
IO_PORT "sdram_addr[1]" IO_TYPE=LVCMOS33;
