// 2 個目の DDR3 (DQ 16〜31、DQS 2〜3、DM 2〜3)。LiteX の定義にはないので、Sipeed の DDR3 のテストの ddr3_1v4_hs.cst から取り込んだ
// (1 個目の分は、LiteX の定義と Sipeed の .cst で 20 本とも同じピンだった)
IO_LOC  "ddram_dq[16]" U5;
IO_PORT "ddram_dq[16]" IO_TYPE=SSTL15 DRIVE=12 PULL_MODE=NONE BANK_VCCIO=1.5;
