// LiteDRAM 版 (build.sh の MEM=litedram) の DDR3 のピン (SOM の DDR3 2 個、DQ 32 ビット)。
// LiteX-Boards の Tang Console の定義 (platforms/sipeed_tang_console.py、78bc7d7) から作った。ポート名は litedram_core に合わせてある
// ライセンス: 1 個目の DDR3 の行は LiteX-Boards の BSD-2-Clause (同じディレクトリの LICENSE.litex-boards)。2 個目の DDR3 の行 (下の
// 「2 個目の DDR3」以降) は、Sipeed の TangMega-138K-example の ddr3_1v4_hs.cst の Apache-2.0 (リポジトリの LICENSE)
IO_LOC  "ddram_a[0]" M1;
IO_PORT "ddram_a[0]" IO_TYPE=SSTL15 DRIVE=12 PULL_MODE=NONE BANK_VCCIO=1.5;
