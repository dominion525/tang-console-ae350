`verilator_config

// カバレッジを数えるのは、Hazard3 版 (rtl/AE350_SOC.v、ae350_plic.v、ae350_plmt.v) と、
// ファブリック側の RTL (rtl/apb_*.v) と shell_top だけ。取り込んだ外部のコードとテストベンチは数えない
coverage_off -file "*hazard3/hdl/*"
coverage_off -file "*vendor/verilog-uart/*"
coverage_off -file "*tb/tb_mem.v"
coverage_off -file "*tb/ahb_*_model.v"
coverage_off -file "*tb/plic_tb.v"
coverage_off -file "*tb/sram_tb.v"
coverage_off -file "*tb/sdram_tb.v"
// 他の設計から流用したファイル (sdram_bridge は流用した回路、SDRAM のモデルは取り込んだ外部のコード) と、SDRAM と IO のテストベンチ用のファイル
coverage_off -file "*rtl/sdram_bridge.v"
coverage_off -file "*zeitlos/sdram_model.v"
coverage_off -file "*tb/sdram_hs_path.v"
coverage_off -file "*tb/gowin_io_models.v"
coverage_off -file "*tb/sdram_io_tb.v"
coverage_off -file "*tb/sdram_pll_tb.v"
